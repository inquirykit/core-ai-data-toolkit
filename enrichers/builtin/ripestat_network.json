{
  "name": "ripestat_network",
  "kind": "http",
  "description": "The prefix and AS numbers announcing an IP address (RIPEstat, keyless)",
  "docs": "https://stat.ripe.net/docs/02.data-api/network-info.html",
  "inputs": [
    "ipv4",
    "ipv6"
  ],
  "terms": "open",
  "attribution": null,
  "secret": null,
  "secret_optional": false,
  "enabled": true,
  "ttl": "7d",
  "rate_limit": null,
  "timeout": 10,
  "value_filters": [],
  "request": {
    "method": "GET",
    "query": {
      "resource": "{value}"
    },
    "headers": {},
    "body": null,
    "body_format": "json",
    "url": "https://stat.ripe.net/data/network-info/data.json"
  },
  "outputs": {
    "asns": "data.asns",
    "prefix": "data.prefix"
  }
}
