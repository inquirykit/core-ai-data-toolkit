{
  "name": "urlhaus_url",
  "kind": "http",
  "description": "Whether a URL is a known malware distribution site (URLhaus by abuse.ch)",
  "docs": "https://urlhaus-api.abuse.ch/",
  "inputs": [
    "url"
  ],
  "terms": "non_commercial",
  "attribution": null,
  "secret": "ABUSECH_KEY",
  "secret_optional": false,
  "enabled": true,
  "ttl": "24h",
  "rate_limit": null,
  "timeout": 10,
  "value_filters": [],
  "request": {
    "method": "POST",
    "query": {},
    "headers": {
      "Auth-Key": "{secret}"
    },
    "body": {
      "url": "{value}"
    },
    "body_format": "form",
    "url": "https://urlhaus-api.abuse.ch/v1/url/"
  },
  "outputs": {
    "query_status": "query_status",
    "url_status": "url_status",
    "threat": "threat",
    "tags": "tags",
    "date_added": "date_added",
    "blacklists": "blacklists",
    "host": "host"
  }
}
