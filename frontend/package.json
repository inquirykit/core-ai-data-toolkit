{
  "name": "ai-toolkit-frontend",
  "private": true,
  "version": "0.2.0-alpha.22",
  "type": "module",
  "description": "The /admin, /admin/setup and /playground pages. Builds into ../api/static.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "cd .. && uv run python scripts/export_openapi.py frontend/openapi.json && cd frontend && openapi-typescript openapi.json --default-non-nullable false -o src/shared/api-schema.d.ts"
  },
  "dependencies": {
