{
  "name": "epss",
  "kind": "http",
  "description": "Probability that a CVE is exploited in the next 30 days (FIRST EPSS, keyless)",
  "docs": "https://api.first.org/epss/",
  "inputs": [
    "cve"
  ],
  "terms": "open",
  "attribution": null,
  "secret": null,
  "secret_optional": false,
  "enabled": true,
  "ttl": "24h",
  "rate_limit": "1000/min",
  "timeout": 10,
  "value_filters": [],
  "request": {
    "method": "GET",
    "query": {
      "cve": "{value}"
    },
    "headers": {},
    "body": null,
    "body_format": "json",
    "url": "https://api.first.org/data/v1/epss"
  },
  "outputs": {
    "epss": "data[0].epss",
    "percentile": "data[0].percentile",
    "date": "data[0].date"
  }
}
