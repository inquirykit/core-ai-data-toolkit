{
  "name": "abuseipdb",
  "kind": "http",
  "description": "Abuse reports and confidence score of an IP address (AbuseIPDB)",
  "docs": "https://docs.abuseipdb.com/",
  "inputs": [
    "ipv4",
    "ipv6"
  ],
  "terms": "non_commercial",
  "attribution": null,
  "secret": "ABUSEIPDB_KEY",
  "secret_optional": false,
  "enabled": true,
  "ttl": "24h",
  "rate_limit": "1000/day",
  "timeout": 10,
  "value_filters": [],
  "request": {
    "method": "GET",
    "query": {
      "ipAddress": "{value}",
      "maxAgeInDays": "90"
    },
    "headers": {
      "Key": "{secret}"
    },
    "body": null,
    "body_format": "json",
    "url": "https://api.abuseipdb.com/api/v2/check"
  },
  "outputs": {
    "score": "data.abuseConfidenceScore",
    "reports": "data.totalReports",
    "last_reported": "data.lastReportedAt",
    "is_tor": "data.isTor",
    "is_whitelisted": "data.isWhitelisted",
    "usage_type": "data.usageType",
    "isp": "data.isp",
    "domain": "data.domain",
    "country": "data.countryCode",
    "hostnames": "data.hostnames"
  }
}
