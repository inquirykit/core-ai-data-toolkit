# Copy to .env (or let the setup wizard at /admin/setup write it). The server
# reads it at startup; a non-empty environment variable wins over it.
# ENV_FILE=/path/to/settings.env points the server at another file.

# Model cache settings. MAX_MEMORY_GB budgets the loaded models' sizes,
# estimated before loading (0 = no budget, only MAX_MODELS). Both can be
# changed live from /admin, which saves them here.
MAX_MODELS=3
MAX_MEMORY_GB=8.0
# Seconds a request may wait for its model (room to load it, or the requests ahead of it) before a 503
MODEL_WAIT_TIMEOUT=120
# Unload a model unused for this many seconds (0 = keep until evicted)
MODEL_IDLE_TIMEOUT=0
# Seconds an idle model keeps its place before another model may take it (0 = none)
MODEL_KEEP_S=3
# Seconds a load waits before it may take a busy model's place from work of the same priority (0 = never)
MODEL_TURN_S=15
# Models to load at startup, comma-separated "model_id:task" ("model_id" alone:
# the task a model file claims it for, else text-generation). PINNED_MODELS
# are loaded too and never evicted; only an explicit unload removes them.
# PRELOAD_MODELS=Qwen/Qwen2.5-0.5B-Instruct:text-generation
# PINNED_MODELS=ibm-granite/granite-embedding-small-english-r2:embedding
# Models served by OpenAI-compatible servers (Ollama, LM Studio, mlx-vlm, vLLM,
# llama-server, ...), each with backends tried in order; see
# model_servers.example.toml. Default: model_servers.toml next to config.py
# MODEL_SERVERS_FILE=/path/to/model_servers.toml
# Where /admin saves its edits of them (each replaces the file's entry of the
# same name); empty makes them read-only in /admin.
# MODEL_SERVERS_SAVED_FILE=data/model_servers.json
# Let /admin save commands (cmd, env) that run on this host. Off: /admin keeps
# only the commands the file already gives.
# MODEL_SERVERS_ALLOW_COMMANDS=false

# API settings. 0.0.0.0 listens on every interface: set API_KEY first
HOST=127.0.0.1
PORT=8000
WORKERS=1

# CORS settings (comma-separated list of allowed origins)
# Use "*" to allow all origins (not recommended for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# Model settings
DEFAULT_DEVICE=auto

# Logging
LOG_LEVEL=INFO

# Development only: auto-reload on code changes (forces WORKERS=1)
RELOAD=false
# Include exception text in HTTP error responses (leaks internals; dev only)
DEBUG=false

# Request limits
MAX_INPUT_CHARS=20000
MAX_GENERATION_LENGTH=1024
# Images and audio in chat messages: bytes per item, and items per request
MAX_MEDIA_BYTES=10485760
MAX_MEDIA_PARTS=8
# /v1/audio/transcriptions upload size, and texts per /v1/embeddings request
MAX_AUDIO_BYTES=26214400
MAX_EMBEDDING_INPUTS=256
# Inputs per POST /inference/batch request
MAX_BATCH_INPUTS=256
# Milliseconds a single request to an idle model waits for others to share a forward pass with (0: no batching)
BATCH_WAIT_MS=2
# Token IDs a /v1/completions prompt given as tokens may hold, and prompts per request
MAX_PROMPT_TOKENS=32768
MAX_COMPLETION_PROMPTS=64
# Hub downloads started from /admin running at once
MAX_HUB_DOWNLOADS=2
# Webhooks: comma-separated URLs POSTed to when a job or eval run finishes, and the
# secret X-Toolkit-Signature signs the body with (empty: unsigned)
WEBHOOK_URLS=
WEBHOOK_SECRET=

# Require this key on every endpoint except / and /health
# (Authorization: Bearer <key> or X-API-Key: <key>). Unset = no authentication.
API_KEY=
# Key for administration: the /admin dashboard, loading/unloading models and
# /models/status. Unset = API_KEY guards those too. Also accepted where API_KEY is.
ADMIN_API_KEY=
# While no key is set, /admin opens the setup wizard. false turns that off.
SETUP_WIZARD=true
# The code the wizard asks for; unset, a random one is logged at startup
# SETUP_CODE=
# Comma-separated model IDs clients may use. Empty = any Hugging Face Hub model.
ALLOWED_MODELS=Qwen/Qwen2.5-0.5B-Instruct,LiquidAI/LFM2.5-230M,AnkitAI/Sensible-ModernBERT-Sentiment-Analysis,deepset/tinyroberta-squad2,apple/FastVLM-1.5B

# Repos allowed to run their own Python code (FastVLM needs it);
# TRUST_REMOTE_CODE=false disables it for all of them
TRUST_REMOTE_CODE=true
TRUST_REMOTE_CODE_MODELS=apple/FastVLM-0.5B,apple/FastVLM-1.5B,apple/FastVLM-7B

# Images passed to /vision-language must be inside this directory
IMAGE_DIR=data/images

# Everything the service stores lives in an embedded ArcadeDB database in this
# directory: /collections, /db tables, traces and evals, the evidence ledger,
# jobs, request metrics and the enrichers' result cache. Empty turns all of
# those off. ArcadeDB runs on a JVM inside this process, using at most
# ARCADEDB_HEAP of memory.
ARCADEDB_PATH=data/arcadedb
ARCADEDB_HEAP=1g

# Days of the /admin dashboard's request history and model events (metadata:
# model, task, outcome, duration), kept in the ArcadeDB database. 0 records none.
MONITORING_RETENTION_DAYS=7

# Traces: each request's input and output, kept in the ArcadeDB database
# for debugging (/admin Traces) and for building benchmark datasets (/admin
# Evals). A day's traces are dropped together once older than this; 0 keeps
# none. Strings longer than TRACE_MAX_CHARS are cut; media is kept as its
# size and hash only.
TRACE_RETENTION_DAYS=3
TRACE_MAX_CHARS=8000
# The LLM judge for benchmark runs: a model this service runs (its ID), or
# one behind an OpenAI-compatible endpoint. Each judging can name another.
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# Jobs: long-running scripts (AutoGluon training) in their own process. See
# jobs/README.md. JOBS_DIR holds each job's files (the job table is in the
# ArcadeDB database); empty turns jobs off. Job params can only name input files in JOB_DATA_DIR.
JOBS_DIR=data/jobs
JOB_DATA_DIR=data/datasets
# Job environments: JOB_ENVS_DIR/<env>, made by scripts/setup_job_env.sh <env>
JOB_ENVS_DIR=envs
MAX_RUNNING_JOBS=1
# Cores a job may use; 0 = every core but one
JOB_NUM_CPUS=0
# cpu, cuda, mps or auto (lets AutoGluon use a GPU)
JOB_DEVICE=cpu
# Largest input file POST /jobs/data accepts, in bytes
JOB_MAX_UPLOAD_BYTES=2147483648

# Enrichers: look a value (IP, domain, hash, email, CVE...) up in outside
# services, edited in /admin's Enrichers section. ENRICHERS_DIR holds your own
# enrichers (one file each); empty turns enrichers off. Results are cached in
# the ArcadeDB database (in memory without one).
ENRICHERS_DIR=data/enrichers
# Sources that may run, by what their terms allow: open, attribution,
# non_commercial, paid. Drop non_commercial for a commercial deployment.
ENRICHER_TERMS=open,attribution,non_commercial,paid
# Let enrichers call private and local addresses (a source on your LAN)
ENRICH_ALLOW_PRIVATE=false
# Enrichers running at once across all lookups
ENRICH_CONCURRENCY=8
# Enrichers' API keys live here too, under the names their definitions give
# (the dashboard writes them), e.g.
# ABUSEIPDB_KEY=
# ABUSECH_KEY=
# IPINFO_TOKEN=

# Evidence capture (/evidence, the Evidence section of /admin): signed,
# hash-chained records of web pages a browser extension captures, with their
# files under EVIDENCE_DIR. Needs ARCADEDB_PATH; empty turns it off. Each
# record's hash is sent to the RFC 3161 time stamping authority at
# EVIDENCE_TSA_URL (only the hash leaves the machine); empty disables that.
# EVIDENCE_KEY_FILE is the Ed25519 signing key, made on first use.
# EVIDENCE_ALLOWED_ORIGINS pins the routes to exact extension origins; empty
# allows any chrome-extension:// or moz-extension:// origin. With
# EVIDENCE_ENRICH, the page's server address and hosts are looked up with the
# enrichers and the results are kept inside the signed record.
EVIDENCE_DIR=data/evidence
EVIDENCE_TSA_URL=https://freetsa.org/tsr
#EVIDENCE_KEY_FILE=data/evidence/keys/ed25519.pem
#EVIDENCE_ALLOWED_ORIGINS=chrome-extension://<your extension's id>
EVIDENCE_ENRICH=true
EVIDENCE_ENRICH_TIMEOUT=20
