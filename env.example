# Copy to .env (or let the setup wizard at /admin/setup write it). The server
# reads it at startup; a non-empty environment variable wins over it.
# ENV_FILE=/path/to/settings.env points the server at another file.

# Everything the service keeps lives in this folder, so it is the one to back
# up or move (docs/GUIDE.md, Backups): the database (toolkit.duckdb), the
# buckets' files (files/), each job's folder (jobs/) and the input files jobs
# read (datasets/), what /admin saves (enrichers/, model_servers.json, and the
# API keys typed into it, encrypted, in secrets.json), the evidence captures
# and their signing key (evidence/), and images/ unless IMAGE_DIR says otherwise.
DATA_DIR=data

# Model cache settings. MAX_MEMORY_GB budgets the loaded models' sizes,
# estimated before loading (0 = no budget, only MAX_MODELS). Both can be
# changed live from /admin, which saves them here.
MAX_MODELS=3
MAX_MEMORY_GB=8.0
# Seconds a request may wait for its model (room to load it, or the requests ahead of it) before a 503
MODEL_WAIT_TIMEOUT=120
# Unload a model unused for this many seconds (0 = keep until evicted)
MODEL_IDLE_TIMEOUT=0
# Seconds an idle model keeps its place before another model may take it (0 = none)
MODEL_KEEP_S=3
# Seconds a load waits before it may take a busy model's place from work of the same priority (0 = never)
MODEL_TURN_S=15
# Models to load at startup, comma-separated "model_id:task" ("model_id" alone:
# the task a model file claims it for, else text-generation). PINNED_MODELS
# are loaded too and never evicted; only an explicit unload removes them.
# PRELOAD_MODELS=Qwen/Qwen2.5-0.5B-Instruct:text-generation
# PINNED_MODELS=ibm-granite/granite-embedding-small-english-r2:embedding
# Models served by OpenAI-compatible servers (Ollama, LM Studio, mlx-vlm, vLLM,
# llama-server, ...), each with backends tried in order; see
# model_servers.example.toml. Default: model_servers.toml in the project root, next to main.py
# MODEL_SERVERS_FILE=/path/to/model_servers.toml
# /admin saves its edits of them in DATA_DIR, each replacing the file's entry
# of the same name.
# Let /admin save commands (cmd, env) that run on this host. Off: /admin keeps
# only the commands the file already gives.
# MODEL_SERVERS_ALLOW_COMMANDS=false
# A provider's API key, if it is not pasted into the provider in /admin, which
# keeps it encrypted. <NAME> is the provider's name in capitals, with _ for -.
# The provider then goes in MODEL_SERVERS_FILE: /admin will not make a new one
# over a key that is already set.
# PROVIDER_OPENAI_API_KEY=

# API keys typed into /admin (providers, enrichers) are kept encrypted in
# DATA_DIR. SECRETS_MASTER_KEY opens them. On a desktop leave it empty: the
# operating system's credential store keeps a master key made on the first save. A container or a
# headless server has none, so set this in its real environment, not here:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_MASTER_KEY=

# API settings. 0.0.0.0 listens on every interface: set API_KEY first
HOST=127.0.0.1
PORT=8000

# CORS settings (comma-separated list of allowed origins)
# Use "*" to allow all origins (not recommended for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# Model settings
DEFAULT_DEVICE=auto

# Logging
LOG_LEVEL=INFO

# Development only: auto-reload on code changes
RELOAD=false
# Include exception text in HTTP error responses (leaks internals; dev only)
DEBUG=false

# Request limits. MAX_INPUT_CHARS is the longest text a model is given, a /db
# row's text embedded for its vector field too (400 past it)
MAX_INPUT_CHARS=20000
MAX_GENERATION_LENGTH=1024
# Images and audio in chat messages: bytes per item, and items per request
MAX_MEDIA_BYTES=10485760
MAX_MEDIA_PARTS=8
# /v1/audio/transcriptions upload size, and texts per /v1/embeddings request
MAX_AUDIO_BYTES=26214400
MAX_EMBEDDING_INPUTS=256
# Inputs per POST /inference/batch request
MAX_BATCH_INPUTS=256
# Milliseconds a single request to an idle model waits for others to share a forward pass with (0: no batching)
BATCH_WAIT_MS=2
# Token IDs a /v1/completions prompt given as tokens may hold, and prompts per request
MAX_PROMPT_TOKENS=32768
MAX_COMPLETION_PROMPTS=64
# Webhooks: comma-separated URLs POSTed to when a job or eval run finishes, and the
# secret X-Toolkit-Signature signs the body with (empty: unsigned)
WEBHOOK_URLS=
WEBHOOK_SECRET=

# Require this key on every endpoint except / and /health
# (Authorization: Bearer <key> or X-API-Key: <key>). Unset = no authentication,
# until a client key is made in /admin (API keys): one per machine, each
# expiring or revoked on its own, so this one can then be left unset.
API_KEY=
# The superadmin key: the /admin dashboard and its API, loading/unloading models,
# /models/status, and making client keys. Unset = API_KEY guards those too. Also
# accepted where API_KEY is. A client key never opens what this one guards.
ADMIN_API_KEY=
# While no key is set, /admin opens the setup wizard. false turns that off.
SETUP_WIZARD=true
# The code the wizard asks for; unset, a random one is logged at startup
# SETUP_CODE=
# Comma-separated model IDs clients may use. Empty = any Hugging Face Hub model.
ALLOWED_MODELS=Qwen/Qwen2.5-0.5B-Instruct,LiquidAI/LFM2.5-230M,AnkitAI/Sensible-ModernBERT-Sentiment-Analysis,deepset/tinyroberta-squad2,apple/FastVLM-1.5B

# Repos allowed to run their own Python code (FastVLM needs it, as do some
# embedding and rerank models); TRUST_REMOTE_CODE=false disables it for all
# of them
TRUST_REMOTE_CODE=true
TRUST_REMOTE_CODE_MODELS=apple/FastVLM-0.5B,apple/FastVLM-1.5B,apple/FastVLM-7B

# Images passed to /vision-language must be inside this directory; unset:
# DATA_DIR/images
# IMAGE_DIR=/path/to/images

# Everything the service stores lives in an embedded DuckDB database in
# DATA_DIR: the /db tables (vector fields among them), traces and evals, the
# evidence ledger, tasks, request metrics and the enrichers' result cache. One
# process opens it. DuckDB runs inside this process and uses at most
# DATABASE_MEMORY for its work (its memory_limit: 1GB, 512MB, or a share of the
# machine's memory, 50%).
# Its full-text extension (fts) is downloaded on the first start, once.
DATABASE_MEMORY=1GB
# Rows a /db table with a vector field holds at most; a write past it is refused
# (413). A search compares the query with every row's vector, so its time grows
# with the rows: about 50 ms per 50,000 vectors of 384 numbers. Each row's vector
# takes dimensions x 4 bytes in the file.
VECTOR_MAX_ROWS=100000
# Buckets: /db tables of files, a row per file (its name, size, sha256, type
# and time), its bytes in DATA_DIR/files/<workspace>/<bucket>/<file id>. A
# bucket is kept until it is deleted; dropping one, or its workspace, deletes
# its files here, not their copies at its remote. A remote (/remotes, the
# admin's Remotes section) names the variables its keys are read from: set
# them here or in the environment, e.g. R2_SECRET_ACCESS_KEY=...; they are no
# settings of their own, and jobs and model servers never get them.
# Largest file a bucket takes, in bytes (413 past it); 1 GiB by default.
# Uploads stream to disk, never into memory, so this guards the disk.
MAX_FILE_BYTES=1073741824
# Views: saved reads over a workspace (SQL, a table's rows, a vector search)
# that the admin writes and a client key runs, drawn on the admin's Data pages
# and dashboards. The rows one answers at most (a view may ask for fewer): as
# many as a page of /db rows or a _query, enough for a chart or a table, and
# what each of the views' cached answers holds at most in memory.
VIEW_MAX_ROWS=1000
# How long a view's SQL may run, in milliseconds (a view may ask for less),
# before it is stopped and the run answers 503. Each run holds one of the
# database's threads, so a slow view cannot keep the others waiting long.
VIEW_TIME_LIMIT_MS=5000

# Days of the request log and model events (model, task, outcome, duration,
# tags), kept in the database for the /admin dashboard. 0 records none, and
# no traces either (what was kept before stays in the database until the data
# folder is deleted). Their hourly summary is kept 90 days, or as long if
# longer.
MONITORING_RETENTION_DAYS=7

# Days of the audit log: every change made through the admin's routes and every
# delete (method, route, key, address, status; never a body). 0 keeps none.
AUDIT_RETENTION_DAYS=365

# Days a workflow's finished runs are kept: each run's counts and the spec it
# ran, which the rows it wrote name in _run. 0 keeps them until the workflow is
# deleted.
WORKFLOW_RUN_DAYS=30

# Traces: each request's inputs and outputs, kept in the request log for
# debugging (Activity & logs) and for building benchmark datasets (/admin
# Evals). They are deleted once older than this (hourly), and never kept
# longer than their request; 0 keeps none. Strings longer than TRACE_MAX_CHARS
# are cut; media is kept as its size and hash only.
TRACE_RETENTION_DAYS=3
TRACE_MAX_CHARS=8000
# The LLM judge for benchmark runs: a model ID, asked through this service's
# own /v1, so one on another server (Ollama, vLLM, a provider) is a model
# server entry (/admin Settings). Each judging can name another.
JUDGE_MODEL=

# Jobs: long-running scripts (AutoGluon training) in their own process. See
# jobs/README.md. Each job's files are in DATA_DIR/jobs; job params can only
# name input files in DATA_DIR/datasets.
# Job environments: JOB_ENVS_DIR/<env>, installed from /admin (the Set up button,
# which queues the setup-env job) or by scripts/setup_job_env.sh <env>.
JOB_ENVS_DIR=envs
MAX_RUNNING_JOBS=1
# Cores a job may use; 0 = every core but one
JOB_NUM_CPUS=0
# cpu, cuda, mps or auto (lets AutoGluon use a GPU)
JOB_DEVICE=cpu
# Largest input file POST /jobs/data accepts, in bytes
JOB_MAX_UPLOAD_BYTES=2147483648

# Enrichers: look a value (IP, domain, hash, email, CVE...) up in outside
# services, edited in /admin's Enrichers section, which saves your own in the
# database, as it caches their results.
# Sources that may run, by what their terms allow: open, attribution,
# non_commercial, paid. Drop non_commercial for a commercial deployment.
ENRICHER_TERMS=open,attribution,non_commercial,paid
# Let enrichers call private and local addresses (a source on your LAN)
ENRICH_ALLOW_PRIVATE=false
# Enrichers running at once across all lookups
ENRICH_CONCURRENCY=8
# Enrichers' API keys live here too, under the names their definitions give
# (the dashboard writes them), e.g.
# ABUSEIPDB_KEY=
# ABUSECH_KEY=
# IPINFO_TOKEN=

# Evidence capture (/evidence, the Evidence section of /admin): signed,
# hash-chained records of web pages a browser extension captures, with their
# files and the Ed25519 key that signs them (made on first use) in
# DATA_DIR/evidence. Each record's hash is sent to the RFC 3161 time stamping
# authority at EVIDENCE_TSA_URL (only the hash leaves the machine); empty
# disables that.
# EVIDENCE_ALLOWED_ORIGINS pins the routes to exact extension origins; empty
# allows any chrome-extension:// or moz-extension:// origin. With
# EVIDENCE_ENRICH, the page's server address and hosts are looked up with the
# enrichers and the results are kept inside the signed record.
EVIDENCE_TSA_URL=https://freetsa.org/tsr
#EVIDENCE_ALLOWED_ORIGINS=chrome-extension://<your extension's id>
EVIDENCE_ENRICH=true
EVIDENCE_ENRICH_TIMEOUT=20
