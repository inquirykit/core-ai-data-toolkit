{
  "name": "ptr",
  "kind": "http",
  "description": "Reverse DNS (PTR) of an IP address (Cloudflare DNS over HTTPS, keyless)",
  "docs": "https://developers.cloudflare.com/1.1.1.1/encryption/dns-over-https/make-api-requests/dns-json/",
  "inputs": [
    "ipv4",
    "ipv6"
  ],
  "terms": "open",
  "attribution": null,
  "secret": null,
  "secret_optional": false,
  "enabled": true,
  "ttl": "24h",
  "rate_limit": null,
  "timeout": 10,
  "value_filters": [
    "reverse_ptr"
  ],
  "request": {
    "method": "GET",
    "query": {
      "name": "{value}",
      "type": "PTR"
    },
    "headers": {
      "Accept": "application/dns-json"
    },
    "body": null,
    "body_format": "json",
    "url": "https://cloudflare-dns.com/dns-query"
  },
  "outputs": {
    "hostname": "Answer[?type==`12`].data | [0]",
    "names": "Answer[?type==`12`].data",
    "status": "Status"
  }
}
